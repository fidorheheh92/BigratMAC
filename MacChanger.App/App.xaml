<Application x:Class="MacChanger.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MacChanger.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                Merge order matters. Palette defines every colour, font, radius
                and text style; Icons defines the glyph geometries; the two
                control dictionaries draw on both, so they must come last.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
                <ResourceDictionary Source="Themes/WindowChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:StatusBrushConverter x:Key="StatusBrush"/>
            <conv:StatusSoftBrushConverter x:Key="StatusSoftBrush"/>
            <conv:ColorToBrushConverter x:Key="ColorToBrush"/>
            <conv:LinkSpeedConverter x:Key="LinkSpeed"/>
            <conv:SectionIconConverter x:Key="SectionIcon"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisible"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToHidden" Invert="True"/>
            <conv:EmptyStringToVisibilityConverter x:Key="TextToVisible"/>
            <conv:EmptyStringToVisibilityConverter x:Key="TextToCollapsed" Invert="True"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
