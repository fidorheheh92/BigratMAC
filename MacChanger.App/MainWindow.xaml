<Window x:Class="MacChanger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BigRat — MAC Address Utility"
        Height="690" Width="1075" MinHeight="580" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource Brush.Canvas}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!--
        ====================================================================
        MainWindow.xaml — the BigRat application shell
        ====================================================================

        The window draws its own title area so BigRat reads as one continuous
        surface rather than "a Windows frame with an app inside it".

        WindowStyle="None" takes the system frame away; the WindowChrome block
        below puts the *behaviour* back — dragging anywhere in the top 48px,
        double-click to maximise, Aero snap, a 6px resize border, and the
        standard taskbar entry. AllowsTransparency is deliberately left off:
        turning it on would cost native resizing and snapping for no visual
        gain, because nothing here needs to be see-through.

        The window's own corners are rounded by the shell rather than by us —
        see ApplyWindowCorners in MainWindow.xaml.cs. That is why the
        WindowChrome below keeps CornerRadius="0": a radius there is applied by
        clipping the window to a hard-edged region, which is both uglier and
        unnecessary when the compositor will round it properly.

        LAYOUT
            a 190px rail (64px when collapsed)  |  a 48px title strip above
        The rail runs the full height of the window, and the button at its foot
        narrows it to an icon-only 64px. The title strip spans only the content
        column, which is why the brand sits in the rail's top 48px — the two
        line up.
    -->

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <!--
                Auto, not 190. The rail is collapsed by animating its own
                Width, and a fixed column would pin the rail at its starting
                size while refusing to let the content column take up the
                slack — the rail would shrink inside its slot and leave a gap.
            -->
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================== Rail ============================== -->
        <!-- No border: the rail is one step up from the window background, and
             that step is what separates it. See the surface ramp in Palette.

             Width lives on the Border rather than on the column so the
             collapse animation has a plain double to work with. The
             code-behind overrides it from the saved setting before the window
             is first shown, so the remembered width is in place on the first
             frame rather than animating in at startup. -->
        <Border x:Name="Rail" Grid.Column="0" Width="190"
                Background="{StaticResource Brush.Sidebar}">
            <DockPanel Margin="12,0,12,12">

                <!--
                    Brand: the mark on its own, with no wordmark beside it. The
                    name only ever crowded the rail, and the window title
                    already says what the application is.

                    The asset is a photograph — Assets/bigrat.jpg, 992x688, and
                    a JPEG, so it has no transparent background to cut out — so
                    it is shown as a rounded tile filled edge to edge rather
                    than as a floating mark.

                    Painting it through the Border's own Background is
                    deliberate. A Border rounds its background to CornerRadius
                    but does *not* clip a child, so an <Image> in here would
                    leave four square corners poking out past the rounding.

                    To swap in a proper logo later, replace the file. If it is a
                    square PNG with transparency, widen the CornerRadius and
                    change the ImageBrush's Stretch back to Uniform.
                -->
                <Border DockPanel.Dock="Top"
                        Width="34" Height="34" CornerRadius="10"
                        Margin="0,7,0,7"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ToolTip="BigRat">
                    <Border.Background>
                        <ImageBrush ImageSource="/Assets/bigrat.jpg"
                                    Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <!--
                    Collapse / expand the rail, at its very foot: a 32px row
                    with a 16px chevron, a 12px label and a 10px gap, exactly
                    as the mockup's `.collapse` row.

                    The chevron points the way the rail is about to move. The
                    two directions are separate geometries rather than one
                    rotated, so they carry the same round caps and joins as
                    the rest of the icon family. The label swaps between
                    "Collapse" and "Expand" with the state, and is dropped on
                    a narrow rail, where the icon is centred instead.
                -->
                <Button DockPanel.Dock="Bottom"
                        Click="RailToggleClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Collapse}">
                            <Setter Property="ToolTip" Value="Collapse navigation"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Settings.SidebarCollapsed}" Value="True">
                                    <Setter Property="ToolTip" Value="Expand navigation"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource Icon.Path}">
                                        <Setter Property="Data" Value="{StaticResource Icon.ChevronLeft}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.SidebarCollapsed}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource Icon.ChevronRight}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Viewbox>
                        <TextBlock Text="Collapse"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="Medium">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Settings.SidebarCollapsed}" Value="True">
                                            <Setter Property="Text" Value="Expand"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <!--
                    Navigation. Five rows, icon first, no section headings —
                    there are not enough destinations to need any.

                    IsChecked is NOT set here: the constructor navigates to the
                    Dashboard and that call sets the check itself. Setting it in
                    markup would fire Checked while the page host further down
                    this file has not been created yet.
                -->
                <StackPanel x:Name="NavList" VerticalAlignment="Top" Margin="0,6,0,0">
                    <RadioButton x:Name="NavDashboard"
                                 Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="Dashboard"
                                 Tag="{StaticResource Icon.Dashboard}"
                                 CommandParameter="Dashboard"
                                 Checked="NavChecked"/>

                    <RadioButton x:Name="NavMacChanger"
                                 Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="MAC Changer"
                                 Tag="{StaticResource Icon.MacChanger}"
                                 CommandParameter="MAC Changer"
                                 Checked="NavChecked"/>

                    <RadioButton x:Name="NavHwid"
                                 Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="Hardware ID"
                                 Tag="{StaticResource Icon.Hwid}"
                                 CommandParameter="HWID"
                                 Checked="NavChecked"/>

                    <RadioButton x:Name="NavHistory"
                                 Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="History"
                                 Tag="{StaticResource Icon.History}"
                                 CommandParameter="History"
                                 Checked="NavChecked"/>

                    <RadioButton x:Name="NavSettings"
                                 Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="Settings"
                                 Tag="{StaticResource Icon.Settings}"
                                 CommandParameter="Settings"
                                 Checked="NavChecked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======================= Title strip and page ===================== -->
        <!--
            This column carries Brush.Sidebar behind everything, and that is
            what makes the rounded corner below visible. The page surface is
            Brush.Canvas, and so is the window, so a notch cut out of the
            surface's top-left corner showed Canvas behind Canvas: the rounding
            was being drawn exactly as asked and simply could not be seen.
            Painting the rail's own surface across the column first gives the
            notch something to reveal.

            Nothing else changes: the title strip and the page surface between
            them cover the rest of the column, so this only ever shows through
            that one corner. See Radius.Content in Palette.xaml.
        -->
        <Grid Grid.Column="1" Background="{StaticResource Brush.Sidebar}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--
                The title area carries the window controls. There is no
                permanent status bar anywhere in BigRat, and no transient one
                here either: an outcome belongs on the page that produced it,
                directly under the action, where it cannot be mistaken for
                something another page did. Anything short enough to be a
                passing remark is a toast at the foot of the window.

                The strip needs no background of its own: the whole content
                column is already Brush.Sidebar, so the strip and the rail read
                as one band across the top of the window.
            -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!--
                    Three coloured dots, in the order a Windows user's hand
                    expects. They carry their colour at rest rather than only
                    under the pointer, and they hold no glyph at all — the
                    colour is the whole signal, which is the one thing a
                    traffic light never needs to explain.

                    Colour is therefore doing all the work, so the tooltips
                    below matter more than they usually would: with no X and no
                    box drawn anywhere, they are how the buttons are told apart
                    on a first visit.

                    Each one needs IsHitTestVisibleInChrome — the strip is the
                    window's caption, and without it the clicks would be
                    swallowed by the drag handler.
                -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,6,0">

                    <Button Style="{StaticResource WindowButton.Minimize}"
                            Click="MinimizeClick"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>

                    <!--
                        Note the style is supplied only as a property element
                        below, never also as a Style attribute: setting the same
                        property twice is invalid markup. The element's BasedOn
                        already inherits everything from WindowButton.Maximize.

                        Maximise and restore are the same button, so the only
                        thing that follows the window's state is the tooltip.
                    -->
                    <Button Click="MaximizeClick"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WindowButton.Maximize}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Maximized">
                                        <Setter Property="ToolTip" Value="Restore"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Style="{StaticResource WindowButton.Close}"
                            Click="CloseClick"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <!--
                The page surface, and the one rounded corner in the layout.

                Only the top-left is rounded. That is the corner where the
                surface meets the rail and the title strip, so rounding it makes
                the content read as a single sheet tucked under the chrome
                rather than as a rectangle butted up against two others. The
                other three corners stay square because they *are* the window's
                own edges, and the shell rounds those.

                The column's sidebar background is what makes the rounding
                visible at all: the notch shows that surface through it. The
                page surface itself is unchanged — still exactly the same
                colour as the window.

                No clipping is needed here. A Border does not clip its children
                to the corner radius, but Pad.Page keeps every page's content
                well clear of this corner, and the pages themselves paint no
                background of their own.

                Pages are created once and cached, so switching away and back
                does not lose what was typed. See MainWindow.xaml.cs.
            -->
            <Border Grid.Row="1"
                    Background="{StaticResource Brush.Canvas}"
                    CornerRadius="{StaticResource Radius.Content}">
                <ContentControl x:Name="PageHost"/>
            </Border>
        </Grid>

        <!--
            ======================== Confirmation dialog =======================

            One dialog for the whole application, drawn on the same surface
            ramp as everything else and shown over a scrim. It replaces the
            operating system's MessageBox, which brought its own type, its own
            button order and its own idea of what a dark application looks
            like.

            The page asks for it through AppState.Confirm and awaits a bool, so
            no page needs to know how it is drawn. From and To are shown side
            by side when the action moves an address; a dialog with nothing to
            move (clearing the history) simply leaves that strip out.

            Keyboard: Escape cancels. Enter is deliberately not wired to the
            confirming button — a confirmation is the one place in the
            application where an accidental keypress is worth less than an
            extra click.
        -->
        <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Border Background="{StaticResource Brush.Scrim}"
                    MouseLeftButtonDown="DialogScrimClick"/>

            <Border x:Name="DialogCard"
                    Width="462"
                    MaxWidth="462"
                    Background="{StaticResource Brush.Card}"
                    CornerRadius="{StaticResource Radius.Card}"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    KeyboardNavigation.TabNavigation="Cycle"
                    PreviewKeyDown="DialogKeyDown"
                    SnapsToDevicePixels="True"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="DialogScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="DialogShift" Y="0"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="70" ShadowDepth="28"
                                      Direction="270" Opacity="0.55"
                                      Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="34" Height="34"
                                CornerRadius="10"
                                Background="{StaticResource Brush.Elevated}"
                                VerticalAlignment="Top">
                            <Viewbox Width="16" Height="16"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.MacChanger}"
                                      Style="{StaticResource Icon.Path}"
                                      Stroke="{StaticResource Brush.TextSecondary}"/>
                            </Viewbox>
                        </Border>

                        <TextBlock x:Name="DialogTitle"
                                   Grid.Column="1"
                                   Margin="12,6,0,0"
                                   FontSize="15.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text}"
                                   TextWrapping="Wrap"
                                   TextOptions.TextFormattingMode="Ideal"/>
                    </Grid>

                    <TextBlock x:Name="DialogBody"
                               Style="{StaticResource Text.Secondary}"
                               FontSize="13"
                               LineHeight="19"
                               Margin="0,14,0,0"/>

                    <!-- Old → new, only when the request carries an address
                         move. Recessed rather than on the card so the two
                         addresses read as one object. -->
                    <Border x:Name="DialogMac"
                            Style="{StaticResource Card.Well}"
                            CornerRadius="12"
                            Padding="13,14"
                            Margin="0,14,0,0"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="DialogFrom"
                                       Style="{StaticResource Text.MonoSecondary}"
                                       Foreground="{StaticResource Brush.TextTertiary}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.TextDecorations>
                                    <TextDecoration Location="Strikethrough"/>
                                </TextBlock.TextDecorations>
                            </TextBlock>

                            <Viewbox Grid.Column="1" Width="16" Height="16" Margin="12,0">
                                <Path Data="{StaticResource Icon.ArrowRight}"
                                      Style="{StaticResource Icon.Path}"
                                      Stroke="{StaticResource Brush.TextTertiary}"/>
                            </Viewbox>

                            <TextBlock x:Name="DialogTo"
                                       Grid.Column="2"
                                       Style="{StaticResource Text.MonoAccent}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <Grid x:Name="DialogNotePanel"
                          Margin="0,12,0,0"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="15" Height="15"
                                 VerticalAlignment="Top" Margin="0,1,0,0">
                            <Path Data="{StaticResource Icon.Info}"
                                  Style="{StaticResource Icon.Path}"
                                  Stroke="{StaticResource Brush.TextTertiary}"/>
                        </Viewbox>
                        <TextBlock x:Name="DialogNote"
                                   Grid.Column="1"
                                   Style="{StaticResource Text.Secondary}"
                                   Margin="8,0,0,0"
                                   FontSize="12.5"
                                   LineHeight="18"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button x:Name="DialogCancel"
                                Style="{StaticResource Button.Secondary}"
                                Content="Cancel"
                                Margin="0,0,10,0"
                                Click="DialogCancelClick"/>
                        <Button x:Name="DialogConfirm"
                                Style="{StaticResource Button.Primary}"
                                Click="DialogConfirmClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!--
            ============================== Toasts ==============================

            A transient remark at the foot of the window, for outcomes too
            short for a card: copied to the clipboard, scan finished, history
            cleared. Never used to announce something that is still running or
            something that did not happen.

            Hit testing is off: a toast must never sit between the pointer and
            the control underneath it. It is drawn after the dialog so it stays
            visible if a toast arrives while one is open.
        -->
        <Grid x:Name="ToastHost"
              Grid.ColumnSpan="2"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Center"
              Margin="0,0,0,24"
              IsHitTestVisible="False"
              Opacity="0">
            <Border Background="{StaticResource Brush.Elevated}"
                    CornerRadius="12"
                    Padding="15,11"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="12"
                                      Direction="270" Opacity="0.45"
                                      Color="#000000"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastShift" Y="0"/>
                </Border.RenderTransform>

                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0">
                        <Path x:Name="ToastGlyph"
                              Style="{StaticResource Icon.Path}"
                              Data="{StaticResource Icon.Check}"
                              Stroke="{StaticResource Brush.Positive}"/>
                    </Viewbox>
                    <TextBlock x:Name="ToastText"
                               Style="{StaticResource Text.Body}"
                               FontSize="13"
                               LineHeight="18"
                               MaxWidth="620"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
