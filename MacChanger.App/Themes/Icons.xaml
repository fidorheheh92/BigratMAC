    <!-- =========================== Status =============================== -->

    <Geometry x:Key="Icon.Warning">M12,3.5 L21.5,20 H2.5 Z M12,9.5 V14.5 M11,17.3 A1,1 0 0 1 13,17.3 A1,1 0 0 1 11,17.3 Z</Geometry>
    <Geometry x:Key="Icon.Info">M12,3.5 A8.5,8.5 0 0 1 20.5,12 A8.5,8.5 0 0 1 3.5,12 A8.5,8.5 0 0 1 12,3.5 Z M12,11 V16.5 M11,7.7 A1,1 0 0 1 13,7.7 A1,1 0 0 1 11,7.7 Z</Geometry>
    <Geometry x:Key="Icon.Shield">M12,3 L19.5,6 V11.5 C19.5,16.2 16.2,19.8 12,21.2 C7.8,19.8 4.5,16.2 4.5,11.5 V6 Z M9.2,11.6 L11.2,13.6 L15,9.4</Geometry>

