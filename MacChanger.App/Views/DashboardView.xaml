<UserControl x:Class="MacChanger.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MacChanger.App.Controls">
    <!--
        ====================================================================
        DashboardView.xaml
        ====================================================================

        The landing page answers five questions in reading order, and nothing
        else is on it:

            1. which adapter           the hero card
            2. what state is it in     the status chip and the address pair
            3. what is it carrying     the Connection card
            4. what can I do next      the action at the foot of the hero
            5. what happened recently  the activity card beside the reading

        The hero spans both columns; the live reading and the record sit side by
        side underneath it. The old layout stacked three full-width cards, which
        put the one live figure and the one historical list in a single column
        and made the page a scroll rather than a glance.

        There is deliberately no row of statistic tiles and no permanent status
        sentence: the adapter on screen is the status, and the MAC Changer page
        is where the list behind it is read properly.
    -->
    <ScrollViewer Style="{StaticResource ScrollViewer.Page}">
        <StackPanel Margin="{StaticResource Pad.Page}" MaxWidth="1180">

            <!-- ============================== Header ============================== -->
            <StackPanel>
                <TextBlock Text="Dashboard" Style="{StaticResource Text.PageTitle}"/>
                <TextBlock Style="{StaticResource Text.PageSubtitle}"
                           Text="This machine's adapter, and what it is doing right now."/>
            </StackPanel>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- =========================== Hero card =========================== -->
                <Border Grid.ColumnSpan="3" Style="{StaticResource Card}">
                    <StackPanel>

                        <!-- Identity and state -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="44" Height="44"
                                    CornerRadius="13"
                                    Background="{StaticResource Brush.Elevated}"
                                    VerticalAlignment="Center">
                                <Viewbox Width="24" Height="24">
                                    <Path Data="{Binding SelectedAdapter.InterfaceType, Converter={StaticResource AdapterIcon}}"
                                          Style="{StaticResource Icon.Path}"
                                          Stroke="{StaticResource Brush.TextSecondary}"/>
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="13,0,16,0"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.CardTitle}"
                                           FontSize="15"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding SelectedAdapter.Name, FallbackValue=No adapter selected, TargetNullValue=No adapter selected}"/>
                                <TextBlock Style="{StaticResource Text.Secondary}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                                    <Run Text="{Binding SelectedAdapter.InterfaceType, Mode=OneWay, Converter={StaticResource InterfaceTypeText}, FallbackValue=—, TargetNullValue=—}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding SelectedAdapter.LinkSpeed, Mode=OneWay, Converter={StaticResource LinkSpeed}, ConverterParameter=link, FallbackValue=—}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding SelectedAdapter.Status, Mode=OneWay, Converter={StaticResource StatusText}, FallbackValue=Unknown, TargetNullValue=Unknown}"/>
                                </TextBlock>

                                <!-- Three possible reasons the hero has no adapter,
                                     and they are not interchangeable. A scan in
                                     progress must not read as "none found", and
                                     a scan that failed must not blame the
                                     machine's drivers for it. -->
                                <StackPanel Margin="0,3,0,0"
                                            Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Text="Scanning for adapters…">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsScanningAdapters}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="The adapter scan failed. Use Rescan on the MAC Changer page to try again.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ScanFailed}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="No supported adapter was found. Rescan on the MAC Changer page to look again.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsScanningAdapters}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ScanFailed}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- Status chip: a rounded rectangle, not a pill. -->
                            <Border Grid.Column="2"
                                    Style="{StaticResource Chip.Small}"
                                    VerticalAlignment="Center"
                                    Background="{Binding SelectedAdapter.Status, Converter={StaticResource StatusSoftBrush}}"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{Binding SelectedAdapter.Status, Converter={StaticResource StatusBrush}}"/>
                                    <TextBlock Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedAdapter.Status, Converter={StaticResource StatusText}, FallbackValue=Unknown, TargetNullValue=Unknown}"
                                               Foreground="{Binding SelectedAdapter.Status, Converter={StaticResource StatusBrush}}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource Chip.Small}"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource Brush.MutedSoft}"
                                    Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisible}}">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="None"
                                           Foreground="{StaticResource Brush.TextSecondary}"/>
                            </Border>
                        </Grid>

                        <!-- ===================== Address and action ===================== -->
                        <Border Style="{StaticResource Divider}" Margin="0,20,0,18"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}"/>
                        <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,28,0" VerticalAlignment="Bottom">
                                <TextBlock Text="CURRENT ADDRESS" Style="{StaticResource Text.SectionLabel}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" MinHeight="30">
                                    <TextBlock Style="{StaticResource Text.MonoAccent}"
                                               VerticalAlignment="Center"
                                               Text="{Binding SelectedAdapter.CurrentMac, FallbackValue=—, TargetNullValue=—}"/>
                                    <Button Style="{StaticResource Button.SmallGhost}"
                                            Margin="4,0,0,0"
                                            Click="CopyAddressClick"
                                            ToolTip="Copy the current address to the clipboard"
                                            AutomationProperties.Name="Copy current address">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="16" Height="16" Margin="0,0,7,0">
                                                <Path Data="{StaticResource Icon.Copy}"
                                                      Style="{StaticResource Icon.Path}"
                                                      Stroke="{StaticResource Brush.TextSecondary}"/>
                                            </Viewbox>
                                            <TextBlock Text="Copy" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!--
                                    The burned-in address is a fact about the
                                    hardware, not a second value the user can
                                    choose from, so it is one quiet sentence
                                    rather than a column beside the address in
                                    use. When the driver will not report it, the
                                    sentence still reads as a sentence.
                                -->
                                <TextBlock Style="{StaticResource Text.Secondary}"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="Burned-in hardware address "/>
                                    <Run Text="{Binding SelectedAdapter.OriginalMac, Mode=OneWay, FallbackValue=not reported by the driver, TargetNullValue=not reported by the driver}"
                                         FontFamily="{StaticResource Font.Mono}"
                                         Foreground="{StaticResource Brush.TextSecondary}"/>
                                    <Run Text=" — read-only"/>
                                </TextBlock>

                                <TextBlock Style="{StaticResource Text.Secondary}"
                                           Margin="0,6,0,0"
                                           MaxWidth="400"
                                           Visibility="{Binding SelectedAdapter.OriginalMac, Converter={StaticResource TextToCollapsed}}"
                                           Text="This adapter's driver does not report its burned-in address. BigRat writes it down the first time it sees this adapter without an override."/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom">
                                <Button Style="{StaticResource Button.Primary}"
                                        Tag="MAC Changer"
                                        Click="NavigateClick"
                                        IsEnabled="{Binding HasSelection}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Open MAC Changer" VerticalAlignment="Center"/>
                                        <Viewbox Width="16" Height="16" Margin="8,0,0,0">
                                            <Path Data="{StaticResource Icon.ArrowRight}"
                                                  Style="{StaticResource Icon.Path}"
                                                  Stroke="{StaticResource Brush.TextOnAccent}"/>
                                        </Viewbox>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========================= Connection ========================= -->
                <!--
                    What the adapter above is carrying right now.

                    Its own card rather than a row inside the hero, because
                    everything in that card is a fixed fact about the adapter
                    and this is the one thing on the page that is different
                    every second.

                    The figure is measured, not guessed at: Windows keeps a
                    running byte total per interface, and this is the difference
                    between two readings a second apart.
                -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CONNECTION" Style="{StaticResource Text.SectionLabel}"
                                       VerticalAlignment="Center"/>

                            <!--
                                The state of the reading, not of the adapter.
                                "Live" only once a figure has actually been
                                measured; before that "Measuring" is the true
                                answer, and when Windows reports no counters the
                                card says so instead of pretending to measure.
                            -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                                <!-- The mockup's live dot: a 7px positive pip with
                                     a 1px ring expanding from 0.7 to 1.5 and
                                     fading out over 2.4s. The ring lives in a
                                     7px grid cell and is allowed to overflow
                                     it, which is exactly what `inset:-3px`
                                     does in the mockup. -->
                                <Grid Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse x:Name="ConnDot" Width="7" Height="7"
                                             Fill="{StaticResource Brush.TextTertiary}"/>
                                    <Ellipse x:Name="ConnPulse"
                                             Width="13" Height="13"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Stroke="{StaticResource Brush.Positive}"
                                             StrokeThickness="1"
                                             Opacity="0"
                                             Visibility="Collapsed"
                                             IsHitTestVisible="False"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="ConnPulseScale"
                                                            ScaleX="0.7" ScaleY="0.7"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <TextBlock x:Name="ConnState"
                                           Margin="7,0,0,0"
                                           Style="{StaticResource Text.Secondary}"
                                           FontSize="12"
                                           Text="Measuring"/>
                            </StackPanel>
                        </Grid>

                        <!-- No adapter: there are no counters to read. -->
                        <TextBlock Style="{StaticResource Text.Secondary}"
                                   Margin="0,14,0,0"
                                   MaxWidth="320"
                                   Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisible}}"
                                   Text="No adapter is selected, so there are no counters to read."/>

                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                            <!-- The figure. The unit rides the number's baseline. -->
                            <TextBlock Style="{StaticResource Text.Metric}"
                                       Margin="0,16,0,0"
                                       Visibility="{Binding Connection.HasReading, Converter={StaticResource BoolToVisible}}">
                                <Run Text="{Binding Connection.DownText, Mode=OneWay}"/>
                                <Run Text="Mbps down"
                                     FontSize="13"
                                     FontWeight="Normal"
                                     Foreground="{StaticResource Brush.TextSecondary}"/>
                            </TextBlock>

                            <!-- The ordinary first second, and the honest
                                 admission that there is no figure to give. -->
                            <TextBlock Style="{StaticResource Text.Secondary}"
                                       Margin="0,16,0,0"
                                       MaxWidth="320"
                                       Visibility="{Binding Connection.IsWaiting, Converter={StaticResource BoolToVisible}}"
                                       Text="Waiting for the first reading."/>
                            <TextBlock Style="{StaticResource Text.Secondary}"
                                       Margin="0,16,0,0"
                                       MaxWidth="320"
                                       Visibility="{Binding Connection.IsUnavailable, Converter={StaticResource BoolToVisible}}"
                                       Text="Windows is not reporting byte counters for this adapter, so there is no figure to show."/>

                            <StackPanel Visibility="{Binding Connection.HasSeries, Converter={StaticResource BoolToVisible}}">
                                <controls:Sparkline Height="132"
                                                    Margin="0,16,0,0"
                                                    Values="{Binding Connection.Series}"
                                                    LineBrush="{DynamicResource Brush.AccentText}"
                                                    SurfaceBrush="{StaticResource Brush.Card}"
                                                    AxisBrush="{StaticResource Brush.ChartGrid}"
                                                    LabelBrush="{StaticResource Brush.TextTertiary}"/>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Text.Secondary}"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.TextTertiary}"
                                               HorizontalAlignment="Left">
                                        <Run Text="{Binding Connection.WindowLabel, Mode=OneWay}"/>
                                        <Run Text=" · log scale"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Text.Secondary}"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.TextTertiary}"
                                               HorizontalAlignment="Right"
                                               Text="{Binding Connection.PeakText, Mode=OneWay}"/>
                                </Grid>
                            </StackPanel>

                            <Border Style="{StaticResource Divider}" Margin="0,16,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="UP" Style="{StaticResource Text.SectionLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Style="{StaticResource Text.Mono}"
                                                   Text="{Binding Connection.UpText, Mode=OneWay}"/>
                                        <TextBlock Style="{StaticResource Text.Secondary}"
                                                   Margin="6,0,0,0"
                                                   Text="Mbps"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="LINK RATE" Style="{StaticResource Text.SectionLabel}"/>
                                    <TextBlock Style="{StaticResource Text.Mono}"
                                               Margin="0,5,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding SelectedAdapter.LinkSpeed, Converter={StaticResource LinkSpeed}}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ======================== Recent activity ======================== -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource Text.SectionLabel}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource Button.Link}"
                                    Tag="History"
                                    Click="NavigateClick"
                                    Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisible}}">
                                <TextBlock Text="View all"/>
                            </Button>
                        </Grid>

                        <!-- Empty state: the first thing a new user sees, so it
                             explains what will appear rather than reading like
                             an error. -->
                        <StackPanel Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVisible}}">
                            <Border Width="46" Height="46"
                                    CornerRadius="13"
                                    Background="{StaticResource Brush.Elevated}"
                                    HorizontalAlignment="Center">
                                <Viewbox Width="22" Height="22"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.History}"
                                          Style="{StaticResource Icon.Path}"
                                          Stroke="{StaticResource Brush.TextSecondary}"/>
                                </Viewbox>
                            </Border>
                            <TextBlock Style="{StaticResource Text.CardTitle}"
                                       FontSize="13.5"
                                       HorizontalAlignment="Center"
                                       Margin="0,13,0,0"
                                       Text="Nothing recorded yet"/>
                            <TextBlock Style="{StaticResource Text.Secondary}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="240"
                                       Margin="0,4,0,0"
                                       Text="Changes you make show up here, with the address that was written and whether it verified."/>
                        </StackPanel>

                        <!-- The five newest, not the whole record: a landing
                             page is a glance at what just happened, and the
                             History page is where the log belongs. -->
                        <ItemsControl Margin="0,4,0,0"
                                      AlternationCount="1000"
                                      ItemsSource="{Binding RecentActivity}"
                                      Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisible}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- One divider *between* rows, never
                                             above the first: the mockup's
                                             `.event + .event`. -->
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Divider}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource ItemPosition}"
                                                                              ConverterParameter="first">
                                                                    <Binding Path="(ItemsControl.AlternationIndex)"
                                                                             RelativeSource="{RelativeSource AncestorType=ContentPresenter}"/>
                                                                    <Binding Path="Items.Count"
                                                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Grid Margin="0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="7" Height="7" Margin="0,6,11,0"
                                                     VerticalAlignment="Top"
                                                     Fill="{Binding OutcomeTone, Converter={StaticResource StatusBrush}}"/>

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Style="{StaticResource Text.BodyStrong}"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding ActivityTitle}"/>
                                                <TextBlock Style="{StaticResource Text.Secondary}"
                                                           FontSize="12"
                                                           Margin="0,1,0,0"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding ActivitySub}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Style="{StaticResource Text.Secondary}"
                                                       Foreground="{StaticResource Brush.TextTertiary}"
                                                       FontSize="12"
                                                       Text="{Binding ActivityTime}"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
