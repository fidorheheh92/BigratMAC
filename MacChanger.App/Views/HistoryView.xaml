<UserControl x:Class="MacChanger.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ====================================================================
        HistoryView.xaml
        ====================================================================

        A timeline rather than a table. Each entry is one operation: when it
        ran, which adapter, what moved to what, and how it ended. The result
        colour is carried by a small dot on the left and by the outcome word on
        the right — no coloured rows, no badges shouting at you.

        The record is written to a file under %APPDATA% as each operation
        finishes, so this page shows what earlier runs did as well as what this
        one has. Two quiet lines under the header name the two states worth
        saying out loud: recording turned off, and a record that could not be
        written to disk.
    -->
    <ScrollViewer Style="{StaticResource ScrollViewer.Page}">
        <StackPanel Margin="{StaticResource Pad.Page}" MaxWidth="780">

            <!-- ============================== Header ============================== -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="History" Style="{StaticResource Text.PageTitle}"/>
                    <TextBlock Style="{StaticResource Text.PageSubtitle}"
                               Text="Every MAC operation BigRat has performed, newest first. Kept on this machine beside your preferences — turning that off, and clearing what is already here, are both in your hands."/>
                </StackPanel>
                <!--
                    The one destructive control in BigRat, so it gets the one
                    destructive style: quiet until you reach for it, then red.
                -->
                <Button Grid.Column="1"
                        VerticalAlignment="Top"
                        Style="{StaticResource Button.Danger}"
                        Click="ClearClick"
                        IsEnabled="{Binding HasHistory}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                            <Path Data="{StaticResource Icon.Trash}"
                                  Style="{StaticResource Icon.Path}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Viewbox>
                        <TextBlock Text="Clear" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!--
                Recording off: one sentence rather than a chip or a warning
                colour. Nothing has gone wrong — the user asked for this — and
                the page only has to say why it is not growing. Visible while
                the preference is false, which is exactly the swap BoolToHidden
                exists for.
            -->
            <TextBlock Style="{StaticResource Text.Secondary}"
                       Margin="0,0,0,18"
                       Visibility="{Binding KeepsHistory, Converter={StaticResource BoolToHidden}}"
                       Text="History recording is off, so nothing new is being written down. Anything recorded before is still below; the switch is on the Settings page."/>

            <!-- The one case that is a failure, so it is the one that gets a
                 status colour and names the consequence. -->
            <TextBlock Style="{StaticResource Text.Secondary}"
                       Margin="0,0,0,18"
                       Foreground="{StaticResource Brush.Warning}"
                       Visibility="{Binding HistoryStorageFailed, Converter={StaticResource BoolToVisible}}"
                       Text="The record could not be written to disk, so this session will not be kept. The file BigRat tried to use is named on the Settings page."/>

            <!-- ============================ Empty state =========================== -->
            <!--
                First run has no history at all, so this is a real screen rather
                than an error. It reads like a designed state: a mark, one
                sentence, and a way to go and create the first entry.
            -->
            <Border Style="{StaticResource Card}"
                    Padding="24,44"
                    Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVisible}}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="16"
                            Background="{StaticResource Brush.Elevated}"
                            HorizontalAlignment="Center">
                        <Viewbox Width="24" Height="24"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.History}"
                                  Style="{StaticResource Icon.Path}"
                                  Stroke="{StaticResource Brush.TextTertiary}"/>
                        </Viewbox>
                    </Border>

                    <TextBlock Style="{StaticResource Text.CardTitle}"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0"
                               Text="Nothing has been recorded yet"/>

                    <TextBlock Style="{StaticResource Text.Secondary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="400"
                               Margin="0,8,0,0"
                               Text="Change or restore a MAC address and the operation will appear here with its result — the failures too, as long as recording is on."/>

                    <Button Style="{StaticResource Button.Secondary}"
                            HorizontalAlignment="Center"
                            Margin="0,18,0,0"
                            Tag="MAC Changer"
                            Click="NavigateClick">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,9,0">
                                <Path Data="{StaticResource Icon.MacChanger}"
                                      Style="{StaticResource Icon.Path}"
                                      Stroke="{StaticResource Brush.Text}"/>
                            </Viewbox>
                            <TextBlock Text="Go to MAC Changer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============================== Timeline ============================ -->
            <Border Style="{StaticResource Card}"
                    Padding="24,20,24,10"
                    Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisible}}">
                <ItemsControl ItemsSource="{Binding History.Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Result dot: success and failure use the same
                                     green/red as every other status in the app. -->
                                <Ellipse Width="7" Height="7"
                                         Margin="0,6,14,0"
                                         VerticalAlignment="Top"
                                         Fill="{Binding Outcome, Converter={StaticResource StatusBrush}}"/>

                                <!-- Wide enough for the dated form, which is
                                     the one that has to fit: the column is a
                                     fixed width so the timestamps stay in a
                                     line down the page. -->
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource Text.Secondary}"
                                           FontSize="12"
                                           Width="112"
                                           Margin="0,0,18,0"
                                           Text="{Binding Time}"/>

                                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Action}"
                                                   Style="{StaticResource Text.BodyStrong}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="  ·  " Style="{StaticResource Text.Secondary}"/>
                                        <TextBlock Text="{Binding AdapterName}"
                                                   Style="{StaticResource Text.Secondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Change}"
                                               Style="{StaticResource Text.MonoSecondary}"
                                               FontSize="12"
                                               Margin="0,6,0,0"/>

                                    <TextBlock Text="{Binding Message}"
                                               Style="{StaticResource Text.Secondary}"
                                               FontSize="11"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding Message, Converter={StaticResource TextToVisible}}"/>
                                </StackPanel>

                                <!-- Coloured chip rather than bare coloured text,
                                     so the outcome stays legible at a glance. -->
                                <Border Grid.Column="3"
                                        Style="{StaticResource Chip.Small}"
                                        VerticalAlignment="Top"
                                        Background="{Binding Outcome, Converter={StaticResource StatusSoftBrush}}">
                                    <TextBlock Text="{Binding Outcome}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding Outcome, Converter={StaticResource StatusBrush}}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
