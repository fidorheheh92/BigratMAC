<UserControl x:Class="MacChanger.App.Views.MacChangerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ====================================================================
        MacChangerView.xaml
        ====================================================================

        Left: every adapter Windows reports, as a picker.
        Right: what the chosen adapter looks like now, then the one action the
        page exists for.

        The right column is two cards, not five. Everything that describes the
        adapter as it stands sits in the first; everything that changes it sits
        in the second, with the rarely-touched options folded into a recessed
        block at its foot instead of getting a card of their own.
    -->
    <Grid Margin="{StaticResource Pad.Page}" MaxWidth="1040">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================== Header ============================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="MAC Changer" Style="{StaticResource Text.PageTitle}"/>
            <TextBlock Style="{StaticResource Text.PageSubtitle}"
                       Text="Pick an adapter, then write a new address or hand the hardware address back."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="258"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- =========================== Adapter picker ======================= -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!--
                        Refresh lives in this card's header because this card's
                        list is what it refreshes. It used to sit in the page
                        header, where it was a lone icon in a corner of the
                        window with nothing on the page aligned against it.
                    -->
                    <Grid Grid.Row="0" Margin="4,0,4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="NETWORK ADAPTERS"
                                   Style="{StaticResource Text.SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource Button.Icon}"
                                Click="RefreshClick"
                                IsEnabled="{Binding IsNotBusy}"
                                ToolTip="Ask Windows for the adapter list again">
                            <Viewbox Width="16" Height="16">
                                <Path Data="{StaticResource Icon.Refresh}"
                                      Style="{StaticResource Icon.Path}"
                                      Stroke="{StaticResource Brush.Text}"/>
                            </Viewbox>
                        </Button>
                    </Grid>

                    <!-- A recessed well, so the list reads as a container the
                         rows sit inside rather than a stack of floating lines. -->
                    <Border Grid.Row="1" Style="{StaticResource Card.Well}" Padding="6,8">
                        <ListBox Style="{StaticResource ListBox.App}"
                                 ItemContainerStyle="{StaticResource ListBoxItem.Adapter}"
                                 ItemsSource="{Binding Adapters}"
                                 SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource Text.BodyStrong}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding InterfaceType}"
                                                       Style="{StaticResource Text.Secondary}"
                                                       FontSize="11"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Style="{StaticResource Chip.Small}"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Style="{StaticResource Text.Secondary}"
                               Margin="4,12,4,2"
                               Text="No supported adapters were found. Read the list again, and make sure the adapter is enabled in Windows."
                               Visibility="{Binding HasNoAdapters, Converter={StaticResource BoolToVisible}}"/>
                </Grid>
            </Border>

            <!-- ============================ Right column ======================== -->
            <ScrollViewer Grid.Column="2" Style="{StaticResource ScrollViewer.Page}">
                <StackPanel>

                    <!-- ==================== What is there now ==================== -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="SELECTED ADAPTER" Style="{StaticResource Text.SectionLabel}"/>
                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                               FontSize="18"
                                               Margin="0,7,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding SelectedAdapter.Name, FallbackValue=No adapter selected, TargetNullValue=No adapter selected}"/>
                                    <TextBlock Style="{StaticResource Text.Secondary}"
                                               Margin="0,5,0,0"
                                               Text="{Binding SelectedAdapter.InterfaceType, FallbackValue=—, TargetNullValue=—}"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Style="{StaticResource Chip}"
                                        VerticalAlignment="Top"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                 Fill="{Binding SelectedAdapter.Status, Converter={StaticResource StatusBrush}}"/>
                                        <TextBlock Margin="7,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding SelectedAdapter.Status, FallbackValue=Unknown, TargetNullValue=Unknown}"
                                                   Foreground="{Binding SelectedAdapter.Status, Converter={StaticResource StatusBrush}}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Style="{StaticResource Text.Secondary}"
                                       Margin="0,16,0,0"
                                       Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisible}}"
                                       Text="Choose an adapter on the left to see what it is using now."/>

                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                                <Border Style="{StaticResource Divider}" Margin="0,16,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="IPv4" Style="{StaticResource Text.Secondary}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" Margin="14,0,24,0"
                                               Text="{Binding SelectedAdapter.IPv4, FallbackValue=—, TargetNullValue=—}"/>
                                    <TextBlock Grid.Column="2" Text="Gateway" Style="{StaticResource Text.Secondary}"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource Text.Mono}" Margin="14,0,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding SelectedAdapter.Gateway, FallbackValue=—, TargetNullValue=—}"/>

                                    <TextBlock Grid.Row="1" Text="IPv6" Style="{StaticResource Text.Secondary}" Margin="0,12,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Mono}" Margin="14,12,24,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding SelectedAdapter.IPv6, FallbackValue=—, TargetNullValue=—}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Link speed" Style="{StaticResource Text.Secondary}" Margin="0,12,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Text.Mono}" Margin="14,12,0,0"
                                               Text="{Binding SelectedAdapter.LinkSpeed, Converter={StaticResource LinkSpeed}}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ======================= The action ======================= -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="MAC ADDRESS" Style="{StaticResource Text.SectionLabel}"/>

                            <Grid Margin="0,16,0,0"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="In use now" Style="{StaticResource Text.Secondary}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource Text.MonoAccent}"
                                           Margin="20,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding SelectedAdapter.CurrentMac, FallbackValue=—, TargetNullValue=—}"/>

                                <TextBlock Grid.Row="1"
                                           Text="Hardware address"
                                           Style="{StaticResource Text.Secondary}"
                                           VerticalAlignment="Center"
                                           Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Style="{StaticResource Text.Mono}"
                                           Margin="20,10,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding SelectedAdapter.OriginalMac, FallbackValue=Not available, TargetNullValue=Not available}"/>
                            </Grid>

                            <!--
                                Shown only while the hardware address is missing
                                *and* an adapter is selected, so the gap explains
                                itself instead of reading as a bug. Both
                                conditions live in the style rather than as a
                                Visibility attribute, because a local value
                                outranks a trigger setter and would pin the
                                sentence on screen for good.

                                Shorter than the Dashboard's wording: this card
                                has less room and the reader is already on the
                                page where the override gets written.
                            -->
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="11"
                                       Text="The driver for this adapter does not report its burned-in address. BigRat writes it down the first time it sees this adapter without an override, and shows it here from then on.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasSelection}" Value="True"/>
                                                    <Condition Binding="{Binding SelectedAdapter.OriginalMac}" Value="{x:Null}"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Style="{StaticResource Divider}" Margin="0,16,0,16"/>

                            <TextBlock Text="NEW ADDRESS" Style="{StaticResource Text.SectionLabel}"
                                       Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewMacBox"
                                         Style="{StaticResource TextBox.App}"
                                         Tag="02:11:22:33:44:55"
                                         IsEnabled="{Binding HasSelection}"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource Button.Secondary}"
                                        Margin="10,0,0,0"
                                        Click="GenerateClick"
                                        IsEnabled="{Binding HasSelection}"
                                        ToolTip="Fill the box with a random address">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="16" Height="16" Margin="0,0,9,0">
                                            <Path Data="{StaticResource Icon.Random}"
                                                  Style="{StaticResource Icon.Path}"
                                                  Stroke="{StaticResource Brush.Text}"/>
                                        </Viewbox>
                                        <TextBlock Text="Random" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock x:Name="NewMacHint"
                                       Style="{StaticResource Text.Secondary}"
                                       Margin="2,10,0,0"
                                       Text="12 hexadecimal digits, for example 02:11:22:33:44:55."/>

                            <!-- The one lime button on the page. -->
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Style="{StaticResource Button.Primary}"
                                        Margin="0,0,10,0"
                                        Click="ApplyClick"
                                        IsEnabled="{Binding CanAct}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="17" Height="17" Margin="0,0,9,0">
                                            <Path Data="{StaticResource Icon.MacChanger}"
                                                  Style="{StaticResource Icon.Path}"
                                                  Stroke="{StaticResource Brush.TextOnAccent}"/>
                                        </Viewbox>
                                        <TextBlock Text="Change MAC address" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Secondary}"
                                        Click="RestoreClick"
                                        IsEnabled="{Binding CanAct}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="16" Height="16" Margin="0,0,9,0">
                                            <Path Data="{StaticResource Icon.Refresh}"
                                                  Style="{StaticResource Icon.Path}"
                                                  Stroke="{StaticResource Brush.Text}"/>
                                        </Viewbox>
                                        <TextBlock Text="Restore original" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- ========================= Options ========================= -->
                            <Border Style="{StaticResource Card.Well}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="BEFORE WRITING" Style="{StaticResource Text.SectionLabel}"/>
                                    <CheckBox Style="{StaticResource CheckBox.App}"
                                              Margin="0,12,0,0"
                                              Content="Restart the adapter afterwards, so the new address takes effect immediately"
                                              IsChecked="{Binding Settings.RestartAdapterAfterChange, Mode=TwoWay}"/>
                                    <CheckBox Style="{StaticResource CheckBox.App}"
                                              Content="Default the generator to a locally administered address (02 first)"
                                              IsChecked="{Binding Settings.Use02FirstOctet, Mode=TwoWay}"/>
                                    <TextBlock Style="{StaticResource Text.Secondary}"
                                               FontSize="11"
                                               Margin="0,10,0,0"
                                               Text="The address is written to the adapter's registry override, so it survives a reboot. &quot;Restore original&quot; removes that override and returns the adapter to its hardware address."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
