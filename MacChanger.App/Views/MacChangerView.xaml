<UserControl x:Class="MacChanger.App.Views.MacChangerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ====================================================================
        MacChangerView.xaml
        ====================================================================

        Left: every adapter Windows reports, as a picker.
        Right: what the chosen adapter looks like now, then the one action the
        page exists for.

        The page has one primary action, and it waits until the address beside
        it is valid. A disabled button with a hint under the field is a better
        answer than a button that accepts a bad address and only complains
        after it has asked the user to confirm.
    -->
    <Grid Margin="{StaticResource Pad.Page}" MaxWidth="1180">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================== Header ============================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="MAC Changer" Style="{StaticResource Text.PageTitle}"/>
            <TextBlock Style="{StaticResource Text.PageSubtitle}"
                       Text="Write a new address to one adapter, or put the original back."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- =========================== Adapter picker ======================= -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ADAPTERS"
                                       Style="{StaticResource Text.SectionLabel}"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Chip.Small}"
                                    Margin="8,0,0,0"
                                    MinWidth="19" Height="19"
                                    Padding="5,0"
                                    CornerRadius="6"
                                    Background="{StaticResource Brush.Elevated}">
                                <TextBlock Text="{Binding Adapters.Count}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextSecondary}"/>
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource Button.Icon}"
                                Click="RefreshClick"
                                IsEnabled="{Binding IsNotBusy}"
                                ToolTip="Scan for adapters again"
                                AutomationProperties.Name="Scan for adapters again">
                            <Viewbox Width="16" Height="16">
                                <Path Data="{StaticResource Icon.Refresh}"
                                      Style="{StaticResource Icon.Path}"
                                      Stroke="{StaticResource Brush.Text}"/>
                            </Viewbox>
                        </Button>
                    </Grid>

                    <ListBox Grid.Row="1"
                             Margin="-6,0,-6,0"
                             ItemContainerStyle="{StaticResource ListBoxItem.Adapter}"
                             ItemsSource="{Binding Adapters}"
                             SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource ListBox.App}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanningAdapters}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasNoAdapters}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Viewbox Width="17" Height="17" Margin="0,2,10,0"
                                             VerticalAlignment="Top">
                                        <Path Data="{Binding InterfaceType, Converter={StaticResource AdapterIcon}}">
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource Icon.Path}">
                                                    <Setter Property="Stroke" Value="{StaticResource Brush.TextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                     Value="True">
                                                            <Setter Property="Stroke" Value="{DynamicResource Brush.AccentText}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Viewbox>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource Text.BodyStrong}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   TextWrapping="Wrap"
                                                   LineHeight="17"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   MaxHeight="34"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"/>
                                        <TextBlock Style="{StaticResource Text.Secondary}"
                                                   Margin="0,2,0,0"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding InterfaceType, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Status, Mode=OneWay, Converter={StaticResource StatusText}}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Selection is the check the mockup uses: the
                                         row already has the accent tint, and a
                                         second outline would be two answers to
                                         the same question. -->
                                    <Viewbox Grid.Column="2"
                                             Width="16" Height="16"
                                             Margin="0,2,0,0"
                                             VerticalAlignment="Top">
                                        <Path Data="{StaticResource Icon.Check}">
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource Icon.Path}">
                                                    <Setter Property="Stroke" Value="{DynamicResource Brush.AccentText}"/>
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                     Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Viewbox>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--
                        The picker with nothing in it. A scan that failed and a
                        scan that completed without finding a supported adapter
                        are different answers, so they get different copy.
                    -->
                    <!--
                        A scan is a visible state of its own: the list is
                        replaced by the mockup's skeleton rather than silently
                        freezing on the previous contents.
                    -->
                    <StackPanel Grid.Row="1"
                                Margin="10,10,10,0"
                                VerticalAlignment="Top"
                                Visibility="{Binding IsScanningAdapters, Converter={StaticResource BoolToVisible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AdapterSkeletonSquare1"
                                    Width="17" Height="17" CornerRadius="5"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource Brush.Elevated}"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82*"/>
                                        <ColumnDefinition Width="18*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="AdapterSkeletonBar1"
                                            Style="{StaticResource SkeletonBar}"
                                            Height="12"/>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46*"/>
                                        <ColumnDefinition Width="54*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="AdapterSkeletonBar2"
                                            Style="{StaticResource SkeletonBar}"
                                            Height="9"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AdapterSkeletonSquare2"
                                    Width="17" Height="17" CornerRadius="5"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource Brush.Elevated}"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64*"/>
                                        <ColumnDefinition Width="36*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="AdapterSkeletonBar3"
                                            Style="{StaticResource SkeletonBar}"
                                            Height="12"/>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38*"/>
                                        <ColumnDefinition Width="62*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="AdapterSkeletonBar4"
                                            Style="{StaticResource SkeletonBar}"
                                            Height="9"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,8" VerticalAlignment="Top">

                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasNoAdapters}" Value="True"/>
                                                <Condition Binding="{Binding IsScanningAdapters}" Value="False"/>
                                                <Condition Binding="{Binding ScanFailed}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="46" Height="46" CornerRadius="13"
                                    Background="{StaticResource Brush.WarningSoft}"
                                    HorizontalAlignment="Center">
                                <Viewbox Width="22" Height="22"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Warning}"
                                          Style="{StaticResource Icon.Path}"
                                          Stroke="{StaticResource Brush.Warning}"/>
                                </Viewbox>
                            </Border>
                            <TextBlock Style="{StaticResource Text.CardTitle}"
                                       FontSize="13.5"
                                       HorizontalAlignment="Center"
                                       Margin="0,13,0,0"
                                       Text="Adapter scan failed"/>
                            <TextBlock Style="{StaticResource Text.Secondary}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="220"
                                       Margin="0,4,0,0"
                                       Text="Windows did not answer the adapter query. Scan again, or restart BigRat."/>
                            <Button Style="{StaticResource Button.SecondarySmall}"
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Center"
                                    Click="RefreshClick"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Content="Scan again"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasNoAdapters}" Value="True"/>
                                                <Condition Binding="{Binding IsScanningAdapters}" Value="False"/>
                                                <Condition Binding="{Binding ScanFailed}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="46" Height="46" CornerRadius="13"
                                    Background="{StaticResource Brush.Elevated}"
                                    HorizontalAlignment="Center">
                                <Viewbox Width="22" Height="22"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Plug}"
                                          Style="{StaticResource Icon.Path}"
                                          Stroke="{StaticResource Brush.TextSecondary}"/>
                                </Viewbox>
                            </Border>
                            <TextBlock Style="{StaticResource Text.CardTitle}"
                                       FontSize="13.5"
                                       HorizontalAlignment="Center"
                                       Margin="0,13,0,0"
                                       Text="No supported adapters"/>
                            <TextBlock Style="{StaticResource Text.Secondary}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="220"
                                       Margin="0,4,0,0"
                                       Text="BigRat only lists adapters whose driver exposes a network address setting."/>
                            <Button Style="{StaticResource Button.SecondarySmall}"
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Center"
                                    Click="RefreshClick"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Content="Scan again"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============================ Right column ======================== -->
            <ScrollViewer Grid.Column="2" Style="{StaticResource ScrollViewer.Page}">
                <StackPanel>

                    <!-- ==================== What is there now ==================== -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="WHAT IS THERE NOW" Style="{StaticResource Text.SectionLabel}"/>

                            <TextBlock Style="{StaticResource Text.Secondary}"
                                       Margin="0,14,0,0"
                                       Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisible}}"
                                       Text="Choose an adapter on the left to see what it is using now."/>

                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                                <Grid Margin="0,9,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Current address" Style="{StaticResource Text.Secondary}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource Text.MonoAccent}"
                                               FontSize="13"
                                               Margin="20,0,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding SelectedAdapter.CurrentMac, FallbackValue=—, TargetNullValue=—}"/>
                                </Grid>

                                <Border Style="{StaticResource Divider}"/>

                                <Grid Margin="0,9,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hardware address" Style="{StaticResource Text.Secondary}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource Text.MonoSecondary}"
                                               Margin="20,0,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding SelectedAdapter.OriginalMac, FallbackValue=Not available, TargetNullValue=Not available}"/>
                                </Grid>

                                <!-- The gap explains itself rather than reading
                                     as a bug. -->
                                <TextBlock Style="{StaticResource Text.Secondary}"
                                           Margin="0,12,0,0"
                                           Visibility="{Binding SelectedAdapter.OriginalMac, Converter={StaticResource TextToCollapsed}}"
                                           Text="The driver for this adapter does not report its burned-in address. BigRat writes it down the first time it sees this adapter without an override, and shows it here from then on."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ======================= The action ======================= -->
                    <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="NEW ADDRESS" Style="{StaticResource Text.SectionLabel}"/>

                            <Grid Margin="0,14,0,0">
                                <TextBox x:Name="NewMacBox"
                                         Style="{StaticResource TextBox.App}"
                                         Tag="02:11:22:33:44:55"
                                         MaxLength="17"
                                         IsEnabled="{Binding HasSelection}"
                                         TextChanged="NewMacTextChanged"
                                         KeyDown="NewMacKeyDown"/>
                                <Button Style="{StaticResource Button.Dice}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"
                                        Click="GenerateClick"
                                        IsEnabled="{Binding HasSelection}"
                                        ToolTip="Generate a random address"
                                        AutomationProperties.Name="Generate a random address">
                                    <Viewbox Width="16" Height="16">
                                        <Path Data="{StaticResource Icon.Random}"
                                              Style="{StaticResource Icon.Path}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <TextBlock x:Name="NewMacHint"
                                       Style="{StaticResource Text.Secondary}"
                                       Margin="0,9,0,0"
                                       MinHeight="18">
                                <Run Text="Any 12 hex digits. BigRat writes them as "/><Run Text="AA:BB:CC:DD:EE:FF" FontFamily="{StaticResource Font.Mono}"/><Run Text="."/>
                            </TextBlock>

                            <!-- The one lime button on the page. -->
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button x:Name="ApplyButton"
                                        Style="{StaticResource Button.Primary}"
                                        Margin="0,0,10,0"
                                        Click="ApplyClick"
                                        IsEnabled="False"
                                        Content="Change MAC address"/>
                                <Button Style="{StaticResource Button.Secondary}"
                                        Click="RestoreClick"
                                        IsEnabled="{Binding CanAct}"
                                        Content="Restore original"/>
                            </StackPanel>

                            <Border Style="{StaticResource Divider}" Margin="0,16,0,14"/>

                            <TextBlock Style="{StaticResource Text.Secondary}">
                                <Run Text="This write restarts the adapter when Windows needs it, and keeps the 02 prefix. Both are in "/>
                                <Hyperlink Style="{StaticResource Hyperlink.App}"
                                           Click="SettingsLinkClick">Settings</Hyperlink>
                                <Run Text="."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!--
                        The result of the action above, on the page that ran it
                        and directly under the button that produced it. The
                        title strip no longer carries status text, so this is
                        where an outcome belongs.
                    -->
                    <Border x:Name="ResultStrip"
                            Style="{StaticResource ResultBanner.Ok}"
                            Margin="0,16,0,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,1,10,0"
                                     VerticalAlignment="Top">
                                <Path x:Name="ResultGlyph"
                                      Style="{StaticResource Icon.Path}"
                                      Data="{StaticResource Icon.Check}"
                                      Stroke="{StaticResource Brush.Positive}"/>
                            </Viewbox>
                            <TextBlock x:Name="ResultText"
                                       Style="{StaticResource Text.Body}"
                                       FontSize="13"
                                       LineHeight="19"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
