<UserControl x:Class="MacChanger.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:MacChanger.App.Services">
    <!--
        ====================================================================
        SettingsView.xaml
        ====================================================================

        Grouped sections, each with a heading, a one-line explanation and then
        its controls — so the page reads as four short paragraphs rather than a
        wall of switches.

        Every row is label-above-description with the control beside it, which
        is why the descriptions can be a full sentence without the page turning
        into a column of grey text.
    -->
    <ScrollViewer Style="{StaticResource ScrollViewer.Page}">
        <StackPanel Margin="{StaticResource Pad.Page}" MaxWidth="700">

            <!-- ============================== Header ============================== -->
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Settings" Style="{StaticResource Text.PageTitle}"/>
                <TextBlock Style="{StaticResource Text.PageSubtitle}"
                           Text="Appearance and behaviour preferences. They are stored on this machine only, and take effect straight away."/>
            </StackPanel>

            <!-- ============================ Appearance ============================ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="APPEARANCE" Style="{StaticResource Text.SectionLabel}"/>
                    <TextBlock Style="{StaticResource Text.Secondary}"
                               Margin="0,8,0,16"
                               Text="The colour used for primary actions, the selected navigation row and important states. Changing it re-colours the whole application immediately; press Save to keep it for next time."/>

                    <ListBox ItemsSource="{x:Static svc:AccentPalette.Options}"
                             SelectedValuePath="Name"
                             SelectedValue="{Binding Settings.Accent, Mode=TwoWay}"
                             SelectionChanged="AccentChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ListBoxItem.Accent}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="16" Height="16" VerticalAlignment="Center"
                                             Fill="{Binding Color, Converter={StaticResource ColorToBrush}}"/>
                                    <TextBlock Text="{Binding Name}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource Text.Body}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- ============================= Behaviour ============================ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="BEHAVIOUR" Style="{StaticResource Text.SectionLabel}"/>
                    <TextBlock Style="{StaticResource Text.Secondary}"
                               Margin="0,8,0,20"
                               Text="What BigRat does around a change, and how much it checks with you first."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource Toggle.Switch}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding Settings.RestartAdapterAfterChange, Mode=TwoWay}"/>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Restart the adapter after writing"
                                       Style="{StaticResource Text.BodyStrong}"/>
                            <TextBlock Style="{StaticResource Text.Secondary}"
                                       Margin="0,4,0,0"
                                       Text="A new address only takes effect once the adapter restarts, so the connection drops for a moment. Leave this on unless you would rather restart it yourself."/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,18,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource Toggle.Switch}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding Settings.ConfirmBeforeApplying, Mode=TwoWay}"/>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Ask before applying"
                                       Style="{StaticResource Text.BodyStrong}"/>
                            <TextBlock Style="{StaticResource Text.Secondary}"
                                       Margin="0,4,0,0"
                                       Text="Show the address the adapter is using and the one you are about to write, and wait for a yes before anything is changed."/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,18,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource Toggle.Switch}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding Settings.Use02FirstOctet, Mode=TwoWay}"/>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Prefer 02 as the first octet"
                                       Style="{StaticResource Text.BodyStrong}"/>
                            <TextBlock Style="{StaticResource Text.Secondary}"
                                       Margin="0,4,0,0"
                                       Text="Default for the Random button on the MAC Changer page. An address starting with 02 is locally administered, which is the conventional choice for a software-set address."/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- =============================== History =========================== -->
            <!--
                Its own section rather than another row in Behaviour, because it
                is the one preference with a file and a destructive control
                attached to it, and both belong beside the switch that governs
                them. The file path sits here rather than in Storage for the
                same reason: Storage is about preferences, this is about the
                record the switch below it decides whether to keep.
            -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="HISTORY" Style="{StaticResource Text.SectionLabel}"/>
                    <TextBlock Style="{StaticResource Text.Secondary}"
                               Margin="0,8,0,20"
                               Text="A record of what BigRat has done, so you can look back at it after the window has been closed."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource Toggle.Switch}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding Settings.KeepHistory, Mode=TwoWay}"/>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Keep a history of changes"
                                       Style="{StaticResource Text.BodyStrong}"/>
                            <TextBlock Style="{StaticResource Text.Secondary}"
                                       Margin="0,4,0,0"
                                       Text="Each change and restore is written to the file below as it finishes, with which adapter it was and how it ended. Turn this off and nothing new is written — what is already there is left alone, and the History page can clear it whenever you want."/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Card.Well}" Margin="0,18,0,0">
                        <TextBlock Style="{StaticResource Text.MonoSecondary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="{Binding History.FilePath}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================== Storage ============================= -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="STORAGE" Style="{StaticResource Text.SectionLabel}"/>
                    <TextBlock Style="{StaticResource Text.Secondary}"
                               Margin="0,8,0,14"
                               Text="Preferences are written to this file when you press Save, and again when BigRat closes."/>

                    <Border Style="{StaticResource Card.Well}">
                        <TextBlock Style="{StaticResource Text.MonoSecondary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="{Binding SettingsStore.FilePath}"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Style="{StaticResource Button.Primary}"
                                Margin="0,0,14,0"
                                Click="SaveClick">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,9,0">
                                    <Path Data="{StaticResource Icon.Check}"
                                          Style="{StaticResource Icon.Path}"
                                          Stroke="{StaticResource Brush.TextOnAccent}"/>
                                </Viewbox>
                                <TextBlock Text="Save preferences" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="SaveStatus"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Secondary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- =============================== About ============================== -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="ABOUT" Style="{StaticResource Text.SectionLabel}"/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Version" Style="{StaticResource Text.Secondary}"/>
                        <TextBlock x:Name="VersionText" Grid.Column="1"
                                   Style="{StaticResource Text.Mono}" FontSize="13"/>

                        <TextBlock Grid.Row="1" Text="Runtime" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0"/>
                        <TextBlock x:Name="RuntimeText" Grid.Row="1" Grid.Column="1"
                                   Style="{StaticResource Text.Mono}" FontSize="13" Margin="0,10,0,0"/>
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,18,0,16"/>

                    <TextBlock Style="{StaticResource Text.Secondary}"
                               Text="BigRat changes the MAC address Windows reports for a network adapter by writing that adapter's registry override. It does not touch any other hardware identifier, and the Hardware ID page only ever reads."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
