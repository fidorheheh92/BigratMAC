<UserControl x:Class="MacChanger.App.Views.HwidView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ====================================================================
        HwidView.xaml
        ====================================================================

        Hardware identification, read only.

        The whole page is one column of collapsible sections. Windows reports
        nine groups of identifiers and printing all of them at once would be a
        wall of serial numbers, so each group is a header you open when you
        need it. System opens by default because it is the one people look for.

        There is no at-a-glance tile row here on purpose: on this page the
        titles plus their fact counts already are the overview, and tiles would
        just be a second copy of the same information.
    -->
    <ScrollViewer Style="{StaticResource ScrollViewer.Page}">
        <StackPanel Margin="{StaticResource Pad.Page}" MaxWidth="820">

            <!-- ============================== Header ============================== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Hardware ID" Style="{StaticResource Text.PageTitle}"/>
                    <TextBlock Style="{StaticResource Text.PageSubtitle}"
                               Text="The hardware identifiers Windows reports for this machine. Read only — nothing here can be edited."/>
                </StackPanel>
                <Button Grid.Column="1"
                        VerticalAlignment="Top"
                        Style="{StaticResource Button.Secondary}"
                        Click="ReloadClick"
                        IsEnabled="{Binding IsNotBusy}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,9,0">
                            <Path Data="{StaticResource Icon.Refresh}"
                                  Style="{StaticResource Icon.Path}"
                                  Stroke="{StaticResource Brush.Text}"/>
                        </Viewbox>
                        <TextBlock Text="Read again" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ============================ Read-only note ======================== -->
            <!-- One quiet line, not a banner: it matters that this page cannot
                 change anything, but it does not need to shout about it. -->
            <Border Style="{StaticResource Card.Tight}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Width="18" Height="18" Margin="0,1,12,0" VerticalAlignment="Top">
                        <Path Data="{StaticResource Icon.Shield}"
                              Style="{StaticResource Icon.Path}"
                              Stroke="{DynamicResource Brush.Accent}"/>
                    </Viewbox>
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource Text.Secondary}"
                               Text="Read only. BigRat queries these values each time the page is opened and never writes, spoofs or stores them. Anything Windows does not report is shown as &quot;Unavailable&quot; rather than guessed."/>
                </Grid>
            </Border>

            <!-- ============================== States ============================= -->
            <StackPanel Margin="0,0,0,16"
                        Visibility="{Binding HasNoHardwareSections, Converter={StaticResource BoolToVisible}}">
                <TextBlock Style="{StaticResource Text.Secondary}"
                           Text="Reading hardware information from Windows…"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"/>
                <TextBlock Style="{StaticResource Text.Secondary}"
                           Text="{Binding HardwareStatus}"
                           Visibility="{Binding IsNotBusy, Converter={StaticResource BoolToVisible}}"/>
            </StackPanel>

            <!-- ============================= Sections ============================ -->
            <ItemsControl ItemsSource="{Binding HardwareSections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,0,0,12">
                            <!-- "System" is the group people come here for, so it
                                 is the one that starts open. -->
                            <Expander.Style>
                                <Style TargetType="Expander" BasedOn="{StaticResource Expander.Section}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Title}" Value="System">
                                            <Setter Property="IsExpanded" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Expander.Style>

                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                        <Path Data="{Binding Title, Converter={StaticResource SectionIcon}}"
                                              Style="{StaticResource Icon.Path}"
                                              Stroke="{StaticResource Brush.TextTertiary}"/>
                                    </Viewbox>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               Style="{StaticResource Text.CardTitle}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>

                                    <!-- Fact count: enough of an overview to know
                                         whether opening a section is worth it. -->
                                    <TextBlock Grid.Column="3"
                                               Style="{StaticResource Text.Secondary}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Text="{Binding Facts.Count, StringFormat={}{0} values}"/>
                                </Grid>
                            </Expander.Header>

                            <StackPanel>
                                <!-- Why a section is empty, in plain words -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,14"
                                            Visibility="{Binding HasNote, Converter={StaticResource BoolToVisible}}">
                                    <Viewbox Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,9,0">
                                        <Path Data="{StaticResource Icon.Warning}"
                                              Style="{StaticResource Icon.Path}"
                                              Stroke="{StaticResource Brush.Warning}"/>
                                    </Viewbox>
                                    <TextBlock Style="{StaticResource Text.Secondary}"
                                               Foreground="{StaticResource Brush.Warning}"
                                               Text="{Binding Note}"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Facts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}"
                                                           Style="{StaticResource Text.Secondary}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1"
                                                           Style="{StaticResource Text.Mono}"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding Value}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
