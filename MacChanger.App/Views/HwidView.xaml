<UserControl x:Class="MacChanger.App.Views.HwidView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ====================================================================
        HwidView.xaml
        ====================================================================

        Hardware identification, read only.

        The whole page is one column of collapsible sections. Windows reports
        nine groups of identifiers, and printing all of them at once would be a
        wall of serial numbers, so each group is a header you open when you
        need it. System opens by default because it is the one people look for.

        Nothing on this page writes. The note above the list says so once, in
        the same information colour the rest of the application uses for
        context — a permanent statement of fact, not an alert.
    -->
    <ScrollViewer Style="{StaticResource ScrollViewer.Page}">
        <StackPanel Margin="{StaticResource Pad.Page}" MaxWidth="840">

            <!-- ============================== Header ============================== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Hardware ID" Style="{StaticResource Text.PageTitle}"/>
                    <TextBlock Style="{StaticResource Text.PageSubtitle}"
                               Text="What Windows reports about this machine. Read-only — BigRat never writes any of it."/>
                </StackPanel>
                <Button Grid.Column="1"
                        VerticalAlignment="Top"
                        Style="{StaticResource Button.Secondary}"
                        Click="ReloadClick"
                        IsEnabled="{Binding IsNotBusy}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                            <Path Data="{StaticResource Icon.Refresh}"
                                  Style="{StaticResource Icon.Path}"
                                  Stroke="{StaticResource Brush.Text}"/>
                        </Viewbox>
                        <TextBlock Text="Read again" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ============================ Read-only note ======================== -->
            <Border Style="{StaticResource ResultBanner}"
                    Background="{StaticResource Brush.InfoSoft}"
                    Padding="12,14"
                    Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top">
                        <Path Data="{StaticResource Icon.Shield}"
                              Style="{StaticResource Icon.Path}"
                              Stroke="{StaticResource Brush.Info}"/>
                    </Viewbox>
                    <TextBlock Grid.Column="1"
                               FontSize="12.5"
                               LineHeight="18"
                               Foreground="{StaticResource Brush.Info}"
                               TextWrapping="Wrap"
                               Text="These values are collected with read-only Windows APIs. Nothing here is sent anywhere."/>
                </Grid>
            </Border>

            <!-- ============================ Reading state ======================== -->
            <!--
                The mockup's skeleton: three bars on a card while WMI answers.
                They pulse only while a read is actually running, and the old
                list is hidden rather than left on screen pretending to be the
                result that has not arrived yet.
            -->
            <Border x:Name="HardwareSkeleton"
                    Style="{StaticResource Card}"
                    Padding="18,20"
                    Visibility="{Binding IsReadingHardware, Converter={StaticResource BoolToVisible}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44*"/>
                            <ColumnDefinition Width="56*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="SkeletonBar1" Style="{StaticResource SkeletonBar}"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72*"/>
                            <ColumnDefinition Width="28*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="SkeletonBar2" Style="{StaticResource SkeletonBar}"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58*"/>
                            <ColumnDefinition Width="42*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="SkeletonBar3" Style="{StaticResource SkeletonBar}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============================== States ============================= -->
            <StackPanel Margin="0,0,0,16"
                        Visibility="{Binding HasNoHardwareSections, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="{Binding HardwareStatus}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReadingHardware}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- ============================= Sections ============================ -->
            <ItemsControl ItemsSource="{Binding HardwareSections}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReadingHardware}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,0,0,10">
                            <!-- The two groups the mockup opens by default:
                                 the processor and the memory modules. -->
                            <Expander.Style>
                                <Style TargetType="Expander" BasedOn="{StaticResource Expander.Section}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Title}" Value="Processor">
                                            <Setter Property="IsExpanded" Value="True"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Title}" Value="Memory modules">
                                            <Setter Property="IsExpanded" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Expander.Style>

                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                        <Path Data="{Binding Title, Converter={StaticResource SectionIcon}}"
                                              Style="{StaticResource Icon.Path}"
                                              Stroke="{StaticResource Brush.TextSecondary}"/>
                                    </Viewbox>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               Style="{StaticResource Text.BodyStrong}"
                                               FontSize="13.5"
                                               Margin="11,0,0,0"
                                               VerticalAlignment="Center"/>

                                    <!-- Fact count: enough of an overview to know
                                         whether opening a section is worth it. -->
                                    <TextBlock Grid.Column="3"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource Brush.TextTertiary}"
                                               VerticalAlignment="Center"
                                               Margin="11,0,0,0"
                                               Text="{Binding FactCountText}"/>
                                </Grid>
                            </Expander.Header>

                            <StackPanel>
                                <!-- Why a section is empty, in plain words -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,14"
                                            Visibility="{Binding HasNote, Converter={StaticResource BoolToVisible}}">
                                    <Viewbox Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,9,0">
                                        <Path Data="{StaticResource Icon.Warning}"
                                              Style="{StaticResource Icon.Path}"
                                              Stroke="{StaticResource Brush.Warning}"/>
                                    </Viewbox>
                                    <TextBlock Style="{StaticResource Text.Secondary}"
                                               Foreground="{StaticResource Brush.Warning}"
                                               Text="{Binding Note}"/>
                                </StackPanel>

                                <!-- One row per fact, with the key in a fixed
                                     column so values line up down the section.
                                     The divider above the first row is hidden:
                                     a rule directly under the header is a line
                                     with nothing on the other side of it. -->
                                <ItemsControl ItemsSource="{Binding Facts}"
                                              AlternationCount="1000">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Border Height="1"
                                                        Background="{StaticResource Brush.Divider}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                                                             Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <Grid Grid.Row="1" Margin="0,8,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="12.5"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1"
                                                               Style="{StaticResource Text.Mono}"
                                                               FontSize="12.5"
                                                               Margin="14,0,0,0"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Value}"/>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
